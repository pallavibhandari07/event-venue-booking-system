<%- include('../partials/header') %>

<div class="container">
  <!-- Alerts -->
  <%- include('../partials/alerts') %>

  <!-- Back Link & Action Bar -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <a href="/venues" class="btn btn-secondary btn-sm">
      ← Back to Venues Directory
    </a>

    <% if (currentUser && currentUser.role === 'admin') { %>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/venues/<%= venue._id %>/edit" class="btn btn-secondary btn-sm">
          ✏️ Edit Venue
        </a>
        <form action="/venues/<%= venue._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this venue?');" style="margin: 0;">
          <button type="submit" class="btn btn-danger btn-sm">
            🗑️ Delete Venue
          </button>
        </form>
      </div>
    <% } %>
  </div>

  <!-- Venue Header Grid -->
  <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; margin-bottom: 2.5rem;" class="venue-detail-hero">
    <div>
      <img 
        src="<%= venue.imageUrl %>" 
        alt="<%= venue.name %>" 
        style="width: 100%; height: 360px; object-fit: cover; border-radius: var(--radius-lg); border: 1px solid var(--border-subtle);"
        onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80'"
      >
    </div>

    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <span class="badge badge-status-<%= venue.status %>"><%= venue.status %></span>
          <span class="facility-tag" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; font-weight: 600;">
            👥 <%= venue.capacity %> Maximum Capacity
          </span>
        </div>

        <h1 style="font-size: 2rem; margin-bottom: 0.35rem;"><%= venue.name %></h1>
        <div style="color: var(--accent-cyan); font-size: 0.95rem; margin-bottom: 1rem;">
          📍 <%= venue.location %>
        </div>

        <p style="margin-bottom: 1.5rem; line-height: 1.7;"><%= venue.description %></p>

        <h4 style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-dim); margin-bottom: 0.6rem;">
          Available Facilities & Equipment
        </h4>
        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem;">
          <% venue.facilities.forEach(fac => { %>
            <span class="facility-tag" style="padding: 0.3rem 0.65rem;">✓ <%= fac %></span>
          <% }); %>
        </div>
      </div>

      <div style="padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
        <div>
          <span style="font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase;">Standard Hourly Rate</span>
          <div style="font-family: var(--font-heading); font-size: 1.8rem; font-weight: 700; color: #fff;">
            ₹<%= venue.hourlyRate.toLocaleString('en-IN') %> <span style="font-size: 0.9rem; font-weight: 400; color: var(--text-muted);">/ hour</span>
          </div>
        </div>

        <a href="#bookingFormCard" class="btn btn-primary">
          Schedule Event ↓
        </a>
      </div>
    </div>
  </div>

  <!-- 2-Column: Day Schedule Inspection & Booking Form -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;" class="venue-detail-bottom">
    
    <!-- Left: Schedule & Availability Timeline -->
    <div>
      <div class="card" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem;">
          <div>
            <h3>📅 Inspect Date Availability</h3>
            <p style="font-size: 0.85rem;">Check booked intervals or maintenance holds</p>
          </div>

          <form action="/venues/<%= venue._id %>" method="GET" style="display: flex; gap: 0.5rem;">
            <input 
              type="date" 
              name="date" 
              class="input-control" 
              value="<%= selectedDate %>" 
              onchange="this.form.submit()"
              style="width: 160px; padding: 0.4rem 0.75rem;"
            >
          </form>
        </div>

        <!-- Maintenance Alert for this date -->
        <% if (dayMaintenance && dayMaintenance.length > 0) { %>
          <% dayMaintenance.forEach(m => { %>
            <div style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); border-radius: var(--radius-md); padding: 0.9rem; margin-bottom: 1rem;">
              <div style="font-weight: 600; color: #fb7185; font-size: 0.875rem;">
                🔧 Maintenance Hold on <%= m.date %> (<%= m.startTime %> - <%= m.endTime %>)
              </div>
              <div style="font-size: 0.8rem; color: #fca5a5; margin-top: 0.2rem;">
                Reason: <%= m.reason %>
              </div>
            </div>
          <% }); %>
        <% } %>

        <!-- Bookings on this date -->
        <h4 style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.75rem;">
          Scheduled Events on <%= selectedDate %>
        </h4>

        <% if (dayBookings && dayBookings.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <% dayBookings.forEach(b => { %>
              <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="color: var(--accent-cyan); font-weight: 600; font-size: 0.85rem;">
                    ⏱️ <%= b.startTime %> - <%= b.endTime %> (<%= b.durationHours %> hrs)
                  </div>
                  <div style="font-weight: 600; color: #fff; margin-top: 0.15rem;">
                    <%= b.eventName %>
                  </div>
                  <div style="font-size: 0.8rem; color: var(--text-dim);">
                    👤 <%= b.organizer.name %> &bull; <%= b.expectedAttendees %> attendees
                  </div>
                </div>

                <span class="badge badge-status-<%= b.status %>"><%= b.status %></span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div style="text-align: center; padding: 2rem; background: rgba(255, 255, 255, 0.02); border-radius: var(--radius-md); border: 1px dashed var(--border-subtle);">
            <div style="font-size: 2rem; margin-bottom: 0.35rem;">✨</div>
            <div style="color: #34d399; font-weight: 600; font-size: 0.95rem;">Entire Day Free!</div>
            <p style="font-size: 0.85rem;">No conflicting events scheduled for <%= selectedDate %>.</p>
          </div>
        <% } %>
      </div>

      <!-- Admin Maintenance Blocking Card -->
      <% if (currentUser && currentUser.role === 'admin') { %>
        <div class="card">
          <div style="margin-bottom: 1rem;">
            <h3 style="color: #fb7185;">🔧 Block Date for Maintenance</h3>
            <p style="font-size: 0.85rem;">Restrict organizers from requesting slots during facilities maintenance.</p>
          </div>

          <form action="/venues/<%= venue._id %>/maintenance" method="POST">
            <div style="margin-bottom: 0.85rem;">
              <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.25rem;">
                Date to Block *
              </label>
              <input type="date" name="date" class="input-control" value="<%= selectedDate %>" required>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.85rem;">
              <div>
                <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.25rem;">
                  Start Time
                </label>
                <input type="time" name="startTime" class="input-control" value="08:00" required>
              </div>
              <div>
                <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.25rem;">
                  End Time
                </label>
                <input type="time" name="endTime" class="input-control" value="22:00" required>
              </div>
            </div>

            <div style="margin-bottom: 1rem;">
              <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.25rem;">
                Reason / Maintenance Notes
              </label>
              <input type="text" name="reason" class="input-control" placeholder="e.g. AV overhaul & laser projector calibration" required>
            </div>

            <button type="submit" class="btn btn-danger btn-sm" style="width: 100%;">
              Confirm Maintenance Block
            </button>
          </form>

          <% if (venue.maintenanceBlocks && venue.maintenanceBlocks.length > 0) { %>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle);">
              <h4 style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.6rem;">
                Active Maintenance Holds (<%= venue.maintenanceBlocks.length %>)
              </h4>
              <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <% venue.maintenanceBlocks.forEach(b => { %>
                  <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; background: rgba(0, 0, 0, 0.2); padding: 0.4rem 0.6rem; border-radius: var(--radius-sm);">
                    <div>
                      <strong><%= b.date %></strong> (<%= b.startTime %> - <%= b.endTime %>): <%= b.reason %>
                    </div>
                    <form action="/venues/<%= venue._id %>/maintenance/<%= b._id %>/delete" method="POST" style="margin: 0;">
                      <button type="submit" style="background: none; border: none; color: #fb7185; cursor: pointer;" title="Remove Block">✕</button>
                    </form>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Right: Booking Request Form -->
    <div class="card" id="bookingFormCard">
      <div style="margin-bottom: 1.5rem;">
        <span class="badge" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; margin-bottom: 0.4rem;">
          Event Reservation
        </span>
        <h2>Request a Booking Slot</h2>
        <p>Submit your event proposal. Conflicts are automatically detected.</p>
      </div>

      <% if (currentUser) { %>
        <form action="/bookings" method="POST">
          <input type="hidden" name="venueId" value="<%= venue._id %>">
          <input type="hidden" id="venueHourlyRate" value="<%= venue.hourlyRate %>">

          <div style="margin-bottom: 1.25rem;">
            <label for="eventName" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.35rem;">
              Event Title *
            </label>
            <input 
              type="text" 
              id="eventName" 
              name="eventName" 
              class="input-control" 
              placeholder="e.g. Annual Tech Symposium & Hackathon" 
              required
            >
          </div>

          <div style="margin-bottom: 1.25rem;">
            <label for="eventDescription" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.35rem;">
              Event Summary / Notes
            </label>
            <textarea 
              id="eventDescription" 
              name="eventDescription" 
              class="input-control" 
              placeholder="Provide a brief description of the event agenda, stage requirements, or guest details..." 
              rows="2"
            ></textarea>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
            <div>
              <label for="bookingDate" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.35rem;">
                Event Date *
              </label>
              <input 
                type="date" 
                id="bookingDate" 
                name="date" 
                class="input-control" 
                value="<%= selectedDate %>" 
                min="<%= new Date().toISOString().split('T')[0] %>"
                required
              >
            </div>

            <div>
              <label for="expectedAttendees" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.35rem;">
                Attendees (Max: <%= venue.capacity %>) *
              </label>
              <input 
                type="number" 
                id="expectedAttendees" 
                name="expectedAttendees" 
                class="input-control" 
                placeholder="e.g. 150" 
                min="1" 
                max="<%= venue.capacity %>" 
                required
              >
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div>
              <label for="bookingStartTime" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.35rem;">
                Start Time *
              </label>
              <input 
                type="time" 
                id="bookingStartTime" 
                name="startTime" 
                class="input-control" 
                value="10:00" 
                required
              >
            </div>

            <div>
              <label for="bookingEndTime" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.35rem;">
                End Time *
              </label>
              <input 
                type="time" 
                id="bookingEndTime" 
                name="endTime" 
                class="input-control" 
                value="13:00" 
                required
              >
            </div>
          </div>

          <!-- Dynamic Live Calculation Box -->
          <div style="background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: var(--radius-md); padding: 1.1rem; margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
              <span style="font-size: 0.85rem; color: var(--text-muted);">Estimated Duration:</span>
              <span style="font-weight: 600; color: #fff;" id="calcDuration">3 hour(s)</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.4rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
              <span style="font-size: 0.95rem; font-weight: 600; color: var(--text-main);">Total Estimated Cost:</span>
              <span style="font-family: var(--font-heading); font-size: 1.35rem; font-weight: 700; color: #34d399;" id="calcTotalCost">₹<%= (venue.hourlyRate * 3).toLocaleString('en-IN') %></span>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; font-size: 1rem;">
            🚀 Submit Booking Request
          </button>
        </form>
      <% } else { %>
        <div style="text-align: center; padding: 2.5rem 1rem;">
          <p style="margin-bottom: 1.25rem;">You must be signed in to submit a venue booking request.</p>
          <a href="/login" class="btn btn-primary">Sign In to Book</a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
