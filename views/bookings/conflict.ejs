<%- include('../partials/header') %>

<div class="container" style="max-width: 960px;">
  <!-- Alerts -->
  <%- include('../partials/alerts') %>

  <!-- Collision Banner -->
  <div class="conflict-banner">
    <div style="display: flex; align-items: flex-start; gap: 1rem;">
      <div style="font-size: 2.25rem;">⚠️</div>
      <div>
        <span class="badge" style="background: rgba(244, 63, 94, 0.25); color: #fb7185; margin-bottom: 0.5rem;">
          Schedule Conflict Detected
        </span>
        <h2 style="color: #fff; margin-bottom: 0.35rem;">Venue Slot Unavailable</h2>
        <p style="color: #fecdd3; font-size: 0.95rem; margin-bottom: 0.75rem;">
          The requested slot on <strong><%= venue.name %></strong> for <strong><%= requestedData.date %></strong> from <strong><%= requestedData.startTime %> to <%= requestedData.endTime %></strong> cannot be booked.
        </p>
        <div style="background: rgba(0, 0, 0, 0.35); padding: 0.75rem 1rem; border-radius: var(--radius-sm); border-left: 3px solid #f43f5e; font-size: 0.875rem; color: #fda4af;">
          <strong>Conflict Reason:</strong> <%= conflictReason %>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem;">💡 Smart Auto-Suggestions</h2>
    <p>Our intelligent allocation engine found available alternatives so your event doesn't get delayed.</p>
  </div>

  <!-- SECTION 1: Alternative Free Slots for THIS Venue on THIS Date -->
  <div class="card" style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <h3 style="color: #38bdf8;">Option A: Alternative Free Slots on "<%= venue.name %>"</h3>
        <p style="font-size: 0.85rem;">Keep this venue on <%= requestedData.date %> by selecting an open time window below:</p>
      </div>
      <span class="badge" style="background: rgba(6, 182, 212, 0.15); color: #38bdf8;">
        <%= alternativeSlots.length %> Slot<%= alternativeSlots.length === 1 ? '' : 's' %> Free
      </span>
    </div>

    <% if (alternativeSlots && alternativeSlots.length > 0) { %>
      <div class="alternative-grid">
        <% alternativeSlots.forEach(slot => { %>
          <div class="alt-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-weight: 600; color: #fff;"><%= slot.label %></span>
              <span class="badge badge-status-available">Available</span>
            </div>
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
              ⏱️ <%= slot.start %> to <%= slot.end %> (3 hours) &bull; Rate: ₹<%= venue.hourlyRate.toLocaleString('en-IN') %>/hr
            </div>

            <form action="/bookings" method="POST">
              <input type="hidden" name="venueId" value="<%= venue._id %>">
              <input type="hidden" name="eventName" value="<%= requestedData.eventName %>">
              <input type="hidden" name="eventDescription" value="<%= requestedData.eventDescription %>">
              <input type="hidden" name="expectedAttendees" value="<%= requestedData.expectedAttendees %>">
              <input type="hidden" name="date" value="<%= requestedData.date %>">
              <input type="hidden" name="startTime" value="<%= slot.start %>">
              <input type="hidden" name="endTime" value="<%= slot.end %>">

              <button type="submit" class="btn btn-cyan btn-sm" style="width: 100%;">
                Book This Slot (₹<%= (venue.hourlyRate * 3).toLocaleString('en-IN') %>) →
              </button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 2rem; color: var(--text-dim);">
        <p>No alternate candidate slots free on <%= venue.name %> for <%= requestedData.date %>.</p>
      </div>
    <% } %>
  </div>

  <!-- SECTION 2: Alternative Available Venues for the EXACT Time Slot -->
  <div class="card" style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <h3 style="color: #34d399;">Option B: Alternative Venues for Your Requested Time (<%= requestedData.startTime %> - <%= requestedData.endTime %>)</h3>
        <p style="font-size: 0.85rem;">Other campus spaces that accommodate your <%= requestedData.expectedAttendees %> attendees at this exact time:</p>
      </div>
      <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
        <%= alternativeVenues.length %> Matching Venue<%= alternativeVenues.length === 1 ? '' : 's' %>
      </span>
    </div>

    <% if (alternativeVenues && alternativeVenues.length > 0) { %>
      <div class="alternative-grid">
        <% alternativeVenues.forEach(alt => { %>
          <div class="alt-card" style="border-color: rgba(16, 185, 129, 0.3);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
              <div>
                <h4 style="color: #fff; font-size: 1.1rem;"><%= alt.venue.name %></h4>
                <div style="font-size: 0.8rem; color: var(--accent-cyan);">📍 <%= alt.venue.location %></div>
              </div>
              <span class="facility-tag" style="background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 600;">
                👥 <%= alt.venue.capacity %> Seats
              </span>
            </div>

            <p style="font-size: 0.825rem; color: var(--text-muted); margin-bottom: 0.75rem;">
              <%= alt.venue.description ? alt.venue.description.substring(0, 75) + '...' : '' %>
            </p>

            <div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 1rem;">
              <% alt.venue.facilities.slice(0, 3).forEach(f => { %>
                <span class="facility-tag">✓ <%= f %></span>
              <% }); %>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; padding-top: 0.5rem; border-top: 1px solid var(--border-subtle);">
              <span style="font-size: 0.85rem; color: var(--text-dim);">Est. Total Cost:</span>
              <span style="font-size: 1.1rem; font-weight: 700; color: #34d399;">₹<%= alt.cost.toLocaleString('en-IN') %></span>
            </div>

            <form action="/bookings" method="POST">
              <input type="hidden" name="venueId" value="<%= alt.venue._id %>">
              <input type="hidden" name="eventName" value="<%= requestedData.eventName %>">
              <input type="hidden" name="eventDescription" value="<%= requestedData.eventDescription %>">
              <input type="hidden" name="expectedAttendees" value="<%= requestedData.expectedAttendees %>">
              <input type="hidden" name="date" value="<%= requestedData.date %>">
              <input type="hidden" name="startTime" value="<%= requestedData.startTime %>">
              <input type="hidden" name="endTime" value="<%= requestedData.endTime %>">

              <button type="submit" class="btn btn-emerald btn-sm" style="width: 100%;">
                Book <%= alt.venue.name %> Instead →
              </button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 2rem; color: var(--text-dim);">
        <p>No other campus venues with sufficient capacity (<%= requestedData.expectedAttendees %> seats) are free during this time window.</p>
      </div>
    <% } %>
  </div>

  <!-- Return Link -->
  <div style="text-align: center;">
    <a href="/venues/<%= venue._id %>" class="btn btn-secondary">
      ← Modify Time or Date Manually on <%= venue.name %>
    </a>
  </div>
</div>

<%- include('../partials/footer') %>
