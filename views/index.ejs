<%- include('partials/header') %>

<div class="container">
  <!-- Alerts / Messages -->
  <%- include('partials/alerts') %>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-pill">
      <span>🚀 Full-Stack Environment Initialized</span>
    </div>
    <h1 class="hero-title">
      Node.js + Express + <span class="grad-text">MongoDB</span> + EJS
    </h1>
    <p class="hero-subtitle">
      A modular Model-View-Controller boilerplate prepared for your assignment. Fully wired with database models, RESTful controllers, dynamic templates, and custom styling.
    </p>

    <!-- Tech Badges -->
    <div class="tech-badges">
      <div class="tech-badge">
        <span class="dot dot-node"></span>
        <span>Node.js <%= systemInfo.nodeVersion %></span>
      </div>
      <div class="tech-badge">
        <span class="dot dot-express"></span>
        <span>Express.js Framework</span>
      </div>
      <div class="tech-badge">
        <span class="dot dot-mongo"></span>
        <span>MongoDB: <%= dbStatus.text %></span>
      </div>
      <div class="tech-badge">
        <span class="dot dot-ejs"></span>
        <span>EJS Templating</span>
      </div>
    </div>
  </section>

  <!-- Live Metrics / Stats Grid -->
  <section class="stats-grid">
    <div class="card">
      <div class="stat-header">
        <span class="stat-label">Database Status</span>
        <div class="stat-icon">🗄️</div>
      </div>
      <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 0.5rem;">
        <span class="status-pill <%= dbStatus.ready ? 'success' : 'danger' %>" id="healthStatusBadge">
          <span class="pulse-dot"></span>
          <%= dbStatus.text %>
        </span>
        <button type="button" class="btn btn-secondary btn-sm" id="btnCheckHealth" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">
          Ping Stack
        </button>
      </div>
    </div>

    <div class="card">
      <div class="stat-header">
        <span class="stat-label">Total Items</span>
        <div class="stat-icon">📊</div>
      </div>
      <div class="stat-value"><%= stats.total %></div>
    </div>

    <div class="card">
      <div class="stat-header">
        <span class="stat-label">In Progress</span>
        <div class="stat-icon">⚡</div>
      </div>
      <div class="stat-value" style="color: #38bdf8;"><%= stats.inProgress %></div>
    </div>

    <div class="card">
      <div class="stat-header">
        <span class="stat-label">Completed</span>
        <div class="stat-icon">✓</div>
      </div>
      <div class="stat-value" style="color: #4ade80;"><%= stats.completed %></div>
    </div>
  </section>

  <!-- Items Management Section -->
  <section class="dashboard-layout">
    <div>
      <div class="section-header">
        <div>
          <h2>Collection Showcase</h2>
          <p>Test live CRUD operations against your MongoDB database.</p>
        </div>

        <div class="items-toolbar">
          <input 
            type="text" 
            id="itemSearchInput" 
            class="input-control" 
            placeholder="Search items..." 
            style="width: 200px;"
          >

          <select id="itemCategoryFilter" class="select-control">
            <option value="All">All Categories</option>
            <option value="General">General</option>
            <option value="Development">Development</option>
            <option value="Design">Design</option>
            <option value="Research">Research</option>
            <option value="Database">Database</option>
          </select>

          <button type="button" class="btn btn-primary" onclick="document.getElementById('btnOpenCreateModal').click()">
            + Add Item
          </button>
        </div>
      </div>

      <!-- Items Grid -->
      <div class="items-grid" id="itemsContainer">
        <% if (items && items.length > 0) { %>
          <% items.forEach(item => { %>
            <div 
              class="card item-card item-card-wrapper <%= item.status.toLowerCase().replace(' ', '-') %>" 
              data-title="<%= item.title %>" 
              data-description="<%= item.description %>" 
              data-category="<%= item.category %>"
            >
              <div class="item-card-top">
                <div class="item-badge-group">
                  <span class="badge badge-category"><%= item.category %></span>
                  <span class="badge badge-priority-<%= item.priority %>"><%= item.priority %></span>
                  
                  <form action="/items/<%= item._id %>/toggle" method="POST" style="display: inline;">
                    <button 
                      type="submit" 
                      class="badge badge-status badge-status-<%= item.status.replace(' ', '-') %>" 
                      title="Click to cycle status"
                      style="border: none; cursor: pointer;"
                    >
                      <%= item.status %> ↻
                    </button>
                  </form>
                </div>

                <h3 class="item-title"><%= item.title %></h3>
                <% if (item.description) { %>
                  <p class="item-desc"><%= item.description %></p>
                <% } else { %>
                  <p class="item-desc" style="font-style: italic; opacity: 0.6;">No description provided.</p>
                <% } %>
              </div>

              <div class="item-card-footer">
                <span class="item-date">
                  <%= new Date(item.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </span>

                <div class="item-actions">
                  <button 
                    type="button" 
                    class="btn btn-secondary btn-sm btn-edit-item" 
                    data-id="<%= item._id %>"
                    data-title="<%= item.title %>"
                    data-description="<%= item.description %>"
                    data-category="<%= item.category %>"
                    data-priority="<%= item.priority %>"
                    data-status="<%= item.status %>"
                    title="Edit Item"
                  >
                    ✏️ Edit
                  </button>

                  <form action="/items/<%= item._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display: inline;">
                    <button type="submit" class="btn btn-danger btn-sm" title="Delete Item">
                      🗑️
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">📦</div>
            <h3 style="margin-bottom: 0.5rem; color: #fff;">No Items Found</h3>
            <p style="margin-bottom: 1.5rem;">Your MongoDB collection is currently empty. Create your first document to verify CRUD operations.</p>
            <button type="button" class="btn btn-primary" onclick="document.getElementById('btnOpenCreateModal').click()">
              + Create First Item
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
