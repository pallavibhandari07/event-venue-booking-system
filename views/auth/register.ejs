<%- include('../partials/header') %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <span style="font-size: 2.25rem;">📝</span>
      <h2 style="margin-top: 0.5rem; margin-bottom: 0.35rem;">Create Account</h2>
      <p>Register as an Event Organiser</p>
    </div>

    <!-- Alerts -->
    <%- include('../partials/alerts') %>

    <form action="/register" method="POST">
      <input type="hidden" name="role" value="organizer">
      <div style="margin-bottom: 1.25rem;">
        <label for="name" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.4rem;">
          Full Name *
        </label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          class="input-control" 
          placeholder="e.g. Alex Rivera" 
          required 
          autofocus
        >
      </div>

      <div style="margin-bottom: 1.25rem;">
        <label for="email" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.4rem;">
          Email Address *
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="input-control" 
          placeholder="e.g. alex@campus.edu" 
          required
        >
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
        <div>
          <label for="organization" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.4rem;">
            Organization / Club
          </label>
          <input 
            type="text" 
            id="organization" 
            name="organization" 
            class="input-control" 
            placeholder="e.g. ACM Chapter"
          >
        </div>
        <div>
          <label for="phone" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.4rem;">
            Phone Number
          </label>
          <input 
            type="text" 
            id="phone" 
            name="phone" 
            class="input-control" 
            placeholder="+1 555-0199"
          >
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label for="password" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.4rem;">
          Password (min 6 characters) *
        </label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="input-control" 
          placeholder="••••••••" 
          minlength="6" 
          required
        >
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">
        Create Account
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-dim);">
      Already have an account? <a href="/login">Sign In</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
